[Unit]
Description=Activate the Drivion Wi-Fi fallback hotspot
After=NetworkManager.service drivion-system-info.service
Wants=NetworkManager.service
Requires=drivion-system-info.service

[Service]
Type=oneshot
Environment=PYTHONPATH={{ service_library_directory }}
ExecStart={{ service_python_executable }} -m system.network.fallback --car-root {{ car_root }} --config-root {{ service_configuration_directory }}
