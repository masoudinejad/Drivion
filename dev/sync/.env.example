# Literal KEY=value format. Quotes are optional; shell expansion is not supported.
PI_HOST=
PI_USER=driver
# Optional: only for key setup or explicit --password sync.
PI_PASSWORD=
# Leave empty to use /home/<PI_USER>/car.
PI_CAR_PATH=
# Optional: select an SSH agent socket (for example your pass-cli daemon socket).
SSH_AUTH_SOCK=
# Optional: select one agent identity via its public key; relative to dev/sync/.
PI_SSH_PUBLIC_KEY=
